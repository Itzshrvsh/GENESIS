{
  "name": "simulation-platform-backend",
  "version": "1.0.0",
  "description": "Express API gateway for the simulation platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.ts --watch src --exec ts-node",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.1",
    "@types/socket.io": "^4.0.1",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
    "eslint": "^8.48.0",
    "@typescript-eslint/parser": "^6.7.5",
    "@typescript-eslint/eslint-plugin": "^6.7.5"
  },
  "engines": {
    "node": ">=20"
  }
}